{
  "name": "granth-storage-indexeddb",
  "version": "0.2.4",
  "description": "IndexedDB storage backend for granth. Works where OPFS does not, including Safari private browsing.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/granthlabs/granth.git",
    "directory": "packages/storage/indexeddb"
  },
  "homepage": "https://github.com/granthlabs/granth/tree/main/packages/storage/indexeddb#readme",
  "bugs": {
    "url": "https://github.com/granthlabs/granth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "sundarshahi <shahithakurisundar@gmail.com>",
  "dependencies": {
    "granth-protocol": "^0.2.4",
    "granth-storage-opfs": "^0.2.4"
  }
}
