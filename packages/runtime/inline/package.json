{
  "name": "granth-runtime-inline",
  "version": "0.1.0",
  "description": "No-Worker runtime for granth. Runs on the calling thread for strict-CSP, SSR, Node and test environments.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sundarshahi/granth.git",
    "directory": "packages/runtime/inline"
  },
  "homepage": "https://github.com/sundarshahi/granth/tree/main/packages/runtime/inline#readme",
  "bugs": {
    "url": "https://github.com/sundarshahi/granth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "sundarshahi <shahithakurisundar@gmail.com>",
  "dependencies": {
    "granth-protocol": "*"
  }
}
