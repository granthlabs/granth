{
  "name": "granth-protocol",
  "version": "0.2.7",
  "description": "Plugin contracts for granth. Types only, zero runtime, zero dependencies.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/granthlabs/granth.git",
    "directory": "packages/core/protocol"
  },
  "homepage": "https://github.com/granthlabs/granth/tree/main/packages/core/protocol#readme",
  "bugs": {
    "url": "https://github.com/granthlabs/granth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "sundarshahi <shahithakurisundar@gmail.com>"
}
