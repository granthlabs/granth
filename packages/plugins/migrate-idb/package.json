{
  "name": "granth-migrate-idb",
  "version": "0.2.0",
  "description": "Migrate an existing IndexedDB or Dexie database into granth.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sundarshahi/granth.git",
    "directory": "packages/plugins/migrate-idb"
  },
  "homepage": "https://github.com/sundarshahi/granth/tree/main/packages/plugins/migrate-idb#readme",
  "bugs": {
    "url": "https://github.com/sundarshahi/granth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "sundarshahi <shahithakurisundar@gmail.com>",
  "dependencies": {
    "granth-protocol": "^0.2.0"
  }
}
