{
  "name": "granth-codemod",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "description": "Automated Dexie -> granth source migration. Rewrites what is safe, reports what is not.",
  "bin": {
    "granth-codemod": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node test-transform.mjs"
  },
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "granthdb",
    "dexie",
    "codemod",
    "migration",
    "indexeddb",
    "sqlite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/granthlabs/granthlabs.github.io.git",
    "directory": "packages/tools/codemod"
  },
  "homepage": "https://github.com/granthlabs/granthlabs.github.io/tree/main/packages/tools/codemod#readme",
  "bugs": {
    "url": "https://github.com/granthlabs/granthlabs.github.io/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "sundarshahi <shahithakurisundar@gmail.com>"
}
