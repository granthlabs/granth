{
  "name": "granth-mcp",
  "version": "0.2.10",
  "type": "module",
  "license": "MIT",
  "description": "MCP server for granthdb. Lets an assistant run real queries against a scratch database and read the actual API surface, instead of guessing from Dexie.",
  "bin": {
    "granth-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node test-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "granth-engine": "^0.2.10",
    "granth-runtime-inline": "^0.2.10",
    "granthdb": "^0.2.10",
    "zod": "^3.25.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "granthdb",
    "mcp",
    "model-context-protocol",
    "sqlite",
    "dexie",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/granthlabs/granth.git",
    "directory": "packages/tools/mcp"
  },
  "homepage": "https://github.com/granthlabs/granth/tree/main/packages/tools/mcp#readme",
  "bugs": {
    "url": "https://github.com/granthlabs/granth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "sundarshahi <shahithakurisundar@gmail.com>"
}
