  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/granthlabs/granth.git",
    "directory": "packages/bindings/vue"
  },
  "homepage": "https://github.com/granthlabs/granth/tree/main/packages/bindings/vue#readme",
  "bugs": {
    "url": "https://github.com/granthlabs/granth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "sundarshahi <shahithakurisundar@gmail.com>",
  "dependencies": {
    "granth-protocol": "^0.2.11"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
