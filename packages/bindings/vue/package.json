{
  "name": "granth-vue",
  "version": "0.2.11",
  "description": "Vue bindings for granth: useLiveQuery composable.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
