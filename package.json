{
  "name": "granth-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/opfs-leader",
    "packages/*/*",
    "examples/playground"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && npm run test -w opfs-leader && npm run test -w granthdb && npm run test -w granth-codemod && npm run test -w playground",
    "test:browser": "npm run build && node examples/playground/browser-test.mjs",
    "dev": "npm run dev -w playground",
    "clean": "tsc -b --clean && rm -rf packages/*/*/dist packages/opfs-leader/dist"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "dexie": "^4.4.5",
    "fake-indexeddb": "^6.2.5",
    "react": "^19.2.8",
    "typescript": "^5.9.0",
    "vue": "^3.5.41"
  },
  "version": "0.2.7"
}
