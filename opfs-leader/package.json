{
  "name": "opfs-leader",
  "version": "0.1.0",
  "description": "One tab owns the worker, every tab can call it. Web Locks leader election and single-writer query routing for OPFS-backed browser databases. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./worker": {
      "types": "./worker.d.ts",
      "default": "./worker.js"
    },
    "./race": {
      "types": "./race.d.ts",
      "default": "./race.js"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "worker.js",
    "race.js",
    "index.d.ts",
    "worker.d.ts",
    "race.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node selfcheck.mjs",
    "prepublishOnly": "node selfcheck.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opfs",
    "sqlite",
    "wasm",
    "web-locks",
    "leader-election",
    "multi-tab",
    "broadcastchannel",
    "worker",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sundarshahi/granth.git",
    "directory": "opfs-leader"
  },
  "bugs": {
    "url": "https://github.com/sundarshahi/granth/issues"
  },
  "homepage": "https://github.com/sundarshahi/granth/tree/main/opfs-leader#readme",
  "publishConfig": {
    "access": "public"
  },
  "author": "sundarshahi <shahithakurisundar@gmail.com>"
}
